{
    "keyboard_name": "Ptechinos (RP2040)",
    "url": "https://github.com/JeremyBois/Ptechinos",
    "maintainer": "JeremyBois",
    "manufacturer": "JeremyBois",
    "usb": {
        "vid": "0x7466", // JB
        "pid": "0x5053", // PS
        "device_version": "0.6.0"
    },
    "build": {
        // LTO must be disabled on RP2040
        "lto": false,
        "debounce_type": "sym_defer_pk"
    },
    "processor": "RP2040",
    "bootloader": "rp2040",
    "bootloader_instructions": "Press twice the physical RESET button on the bottom of the board.",
    "tags": [
        "ortho",
        "split",
        "trackball",
        "trackpad",
        "choc v1",
        "choc spaced"
    ],
    "development_board": "kb2040",
    "pin_compatible": "promicro",
    "debounce": 8, // Default is 5 (lower is better)
    // Keyboard Matrix Assignments
    // https://learn.adafruit.com/adafruit-kb2040/pinouts
    // ROWS: AVR pins used for rows, top to bottom
    // COLS: AVR pins used for columns, left to right
    // DIODE_DIRECTION :
    //  COL2ROW = COL = Anode(+), ROW = Cathode(-, marked on diode)
    //  ROW2COL = ROW = Anode(+), COL = Cathode(-, marked on diode)
    "diode_direction": "COL2ROW",
    "matrix_pins": {
        "cols": [
            "GP26",
            "GP18",
            "GP20",
            "GP19",
            "GP10"
        ],
        "rows": [
            "GP6",
            "GP7",
            "GP8",
            "GP9"
        ]
    },
    "split": {
        "enabled": true,
        // The way how "handedness" is decided (which half is which)
        // see https://docs.qmk.fm/#/feature_split_keyboard?id=setting-handedness
        // "main": "right",  // BUG : Fixed by PR at https://github.com/qmk/qmk_firmware/pull/18254
        "main": "eeprom",
        // https://github.com/qmk/qmk_firmware/blob/master/docs/serial_driver.md#usart-half-duplex "protocol": "serial",
        "transport": {
            "protocol": "serial"
        },
        "serial": {
            "driver": "vendor",
            "pin": "GP1"
        },
        "soft_serial_speed": 1,
        // Detect master using USB connection
        "usb_detect": {
            "enabled": true,
            "timeout": 2000,
            "polling_interval": 10
        }
    },
    "features": {
        // Rotary encoders (+1112)
        "encoder": false,
        // Mouse keys (+1482). Not required for trackball usage
        "mousekey": true,
        // Audio control and System control (+450)
        "extrakey": true,
        // Allow to write combo
        "combo": true,
        // Make easier to write Caps words
        "caps_word": false,
        // 6KRO by default. NKRO works if enabled (+328)
        // Device can be not recognize by Windows
        "nkro": false,
        // Save space by not using sounds
        "audio": false,
        "music": false,
        //  Must be disabled if OLEDs are not installed (+3608-4774 with pet)
        "oled": false,
        "quantum_painter": false,
        // Allow to send unicode characters (cannot be used with unicode_map)
        "unicode": false,
        // Save space by not using space cadet left/right shift (+350)
        "space_cadet": false,
        // Allow tap dance combinations. Not required with custom tapdance feature
        "tap_dance": false,
        // Combinaisons with a leader key. Not required with custom leader feature
        "leader": false,
        // Software way to enter boot mode
        "bootmagic": false,
        // Console for debug (+4686)
        "console": false,
    },
    "qmk": {
        // Add as little delay as possible while still pleasing Windows laggy OS
        "tap_keycode_delay": 5
    },
    "tapping": {
        "term": 220,
        // How many taps before triggering the toggle
        "toggle": 2
    },
    "encoder": {
        "rotary": [
            // EVQWGD001
            {
                "pin_a": "GP29",
                "pin_b": "GP28",
                "resolution": 4
            },
            // EVQWGD001
            {
                "pin_a": "GP4",
                "pin_b": "GP5",
                "resolution": 4
            }
        ]
    },
    "combo": {
        // Default combo timeout is 200ms.
        "term": 50
    },
    "mouse_key": {
        // https://www.reddit.com/r/olkb/comments/72u8ou/qmk_mouse_keys_rock/
        "enabled": true,
        "delay": 0,
        "interval": 16, // 60Hz
        "max_speed": 3,
        "time_to_max": 64,
        "wheel_delay": 0
    },
    "oneshot": {
        // Sticky key activation (high to only support it in code)
        "tap_toggle": 10,
        // Sticky key duration
        "timeout": 4000
    },
    "caps_word": {
        "enabled": false,
        "both_shifts_turns_on": false,
        "invert_on_shift": true
    },
    "leader_key": {
        "timing": false,
        // Default leader timeout is 200ms
        "timeout": 400
    },
    "host_language": "us_international",
    "layout_aliases": {
        "LAYOUT": "LAYOUT_v06"
    },
    "layouts": {
        "LAYOUT_v06": {
            "layout": [
                // Top
                {
                    "label": "L01_Encoder",
                    "encoder": 0,
                    "matrix": [0, 0], "x": 1, "y": 0, "hand": "L"
                },
                {"label": "L05", "matrix": [0, 1], "x": 2, "y": 0, "hand": "L"},
                {"label": "L09", "matrix": [0, 2], "x": 3, "y": 0, "hand": "L"},
                {"label": "L13", "matrix": [0, 3], "x": 4, "y": 0, "hand": "L"},
                {"label": "L17", "matrix": [0, 4], "x": 5, "y": 0, "hand": "L"},
                {"label": "R17", "matrix": [4, 4], "x": 11, "y": 0, "hand": "R"},
                {"label": "R13", "matrix": [4, 3], "x": 12, "y": 0, "hand": "R"},
                {"label": "R09", "matrix": [4, 2], "x": 13, "y": 0, "hand": "R"},
                {"label": "R05", "matrix": [4, 1], "x": 14, "y": 0, "hand": "R"},
                {
                    "label": "R01_Encoder",
                    "encoder": 2,
                    "matrix": [4, 0], "x": 15, "y": 0, "hand": "R"
                },

                // Middle
                {"label": "L04", "matrix": [3, 0], "x": 0,   "y": 1, "hand": "L"},
                {"label": "L02", "matrix": [1, 0], "x": 1, "y": 1, "hand": "L"},
                {"label": "L06", "matrix": [1, 1], "x": 2, "y": 1, "hand": "L"},
                {"label": "L10", "matrix": [1, 2], "x": 3, "y": 1, "hand": "L"},
                {"label": "L14", "matrix": [1, 3], "x": 4, "y": 1, "hand": "L"},
                {"label": "L18", "matrix": [1, 4], "x": 5, "y": 1, "hand": "L"},
                {"label": "R18", "matrix": [5, 4], "x": 11, "y": 1, "hand": "R"},
                {"label": "R14", "matrix": [5, 3], "x": 12, "y": 1, "hand": "R"},
                {"label": "R10", "matrix": [5, 2], "x": 13, "y": 1, "hand": "R"},
                {"label": "R06", "matrix": [5, 1], "x": 14, "y": 1, "hand": "R"},
                {"label": "R02", "matrix": [5, 0], "x": 15, "y": 1, "hand": "R"},
                {"label": "R04", "matrix": [7, 0], "x": 16,   "y": 1, "hand": "R"},

                // Low
                {"label": "L03", "matrix": [2, 0], "x": 1, "y": 2, "hand": "L"},
                {"label": "L07", "matrix": [2, 1], "x": 2, "y": 2, "hand": "L"},
                {"label": "L11", "matrix": [2, 2], "x": 3, "y": 2, "hand": "L"},
                {"label": "L15", "matrix": [2, 3], "x": 4, "y": 2, "hand": "L"},
                {"label": "L19", "matrix": [2, 4], "x": 5, "y": 2, "hand": "L"},
                {
                    "label": "L20_Encoder",
                    "encoder": 1,
                    "matrix": [3, 4], "x": 6, "y": 2, "hand": "L"
                },
                {
                    "label": "R20_Encoder",
                    "encoder": 3,
                    "matrix": [7, 4], "x": 10, "y": 2, "hand": "R"
                },
                {"label": "R19", "matrix": [6, 4], "x": 11, "y": 2, "hand": "R"},
                {"label": "R15", "matrix": [6, 3], "x": 12, "y": 2, "hand": "R"},
                {"label": "R11", "matrix": [6, 2], "x": 13, "y": 2, "hand": "R"},
                {"label": "R07", "matrix": [6, 1], "x": 14, "y": 2, "hand": "R"},
                {"label": "R03", "matrix": [6, 0], "x": 15, "y": 2, "hand": "R"},

                // Thumbs
                {"label": "L08", "matrix": [3, 1], "x": 4.5, "y": 3, "hand": "*"},
                {"label": "L12", "matrix": [3, 2], "x": 5.5, "y": 3, "w": 1.5, "hand": "*"},
                {"label": "L16", "matrix": [3, 3], "x": 7,   "y": 3, "hand": "*"},

                {"label": "R16", "matrix": [7, 3], "x": 9,    "y": 3, "hand": "*"},
                {"label": "R12", "matrix": [7, 2], "x": 10,   "y": 3, "w": 1.5, "hand": "*"},
                {"label": "R08", "matrix": [7, 1], "x": 11.5, "y": 3, "hand": "*"}
            ]
        }
    }
}
